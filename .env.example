# Copy to .env and adjust. Read by the backend at start-up.
DI_DATA_DIR=./data
# DI_API_KEY=change-me                 # require X-API-Key on /api calls
# ANTHROPIC_API_KEY=sk-ant-...         # enable grounded LLM extraction (optional)
# DI_LLM_MODEL=claude-haiku-5-5
DI_WORKERS=2
DI_MAX_ATTEMPTS=2
DI_MAX_UPLOAD_MB=25
DI_MAX_FILES=50
DI_MAX_OCR_PAGES=200
DI_CORS_ORIGINS=http://localhost:5173
